<Application x:Class="SlicerPro.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Cyan" Color="#32D8FF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF6FF"/></Style>
  <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#142C3C" Offset="0"/><GradientStop Color="#08141E" Offset="0.2"/><GradientStop Color="#08121A" Offset="1"/></LinearGradientBrush>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="Background" Value="#060D14"/></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#142C3C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#32D8FF"/><Setter Property="Padding" Value="10"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F2F7FC"/><Setter Property="Background" Value="#14232E"/><Setter Property="BorderBrush" Value="#526E7E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#52E5FF"/><Setter TargetName="Chrome" Property="Background" Value="#12435B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#006A91"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="GlowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#075579"/><GradientStop Color="#073046" Offset="0.6"/><GradientStop Color="#08769C" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="BorderBrush" Value="#62E5FF"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00C8FF" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelFill}"/><Setter Property="BorderBrush" Value="#4688A4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="13"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F4F8FF"/><Setter Property="Background" Value="#0A1721"/><Setter Property="BorderBrush" Value="#526F80"/><Setter Property="Padding" Value="7,5"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#32D8FF"/></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="Background" Value="#0A1721"/><Setter Property="BorderBrush" Value="#526F80"/></Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="Padding" Value="6,4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#153446"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#15516A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#10212F"/><Setter Property="BorderBrush" Value="#526F80"/><Setter Property="Padding" Value="7,5"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#10212F"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#126482"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0A1721" BorderBrush="#526F80" BorderThickness="1" CornerRadius="4"><TextBlock Text="⌄" Foreground="White" HorizontalAlignment="Right" Margin="0,0,9,3" FontSize="17"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="8,5,27,5" IsHitTestVisible="False"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#10212F" BorderBrush="#3DA5C6" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E4EFF6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,5"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#10212F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3DA5C6"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Background" Value="#10212F"/><Setter Property="Foreground" Value="White"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#126482"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 </Application.Resources>
</Application>
