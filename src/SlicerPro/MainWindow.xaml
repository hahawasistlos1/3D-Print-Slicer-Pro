<Window x:Class="SlicerPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SlicerPro.Controls" Title="3D Print Slicer Pro" Width="1620" Height="940" MinWidth="1200" MinHeight="760" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico" AllowDrop="True" Drop="FileDropped" Closing="WindowClosing">
 <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/><KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/><KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo"/><KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo"/></Window.InputBindings>
 <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Open" Executed="OpenModelCommand"/><CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand"/><CommandBinding Command="ApplicationCommands.Undo" Executed="UndoCommand"/><CommandBinding Command="ApplicationCommands.Redo" Executed="RedoCommand"/></Window.CommandBindings>
 <Grid>
  <Grid.Background><RadialGradientBrush Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#0D2838"/><GradientStop Color="#04090E" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="99"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border BorderBrush="#13627F" BorderThickness="0,0,0,1" Background="#080F16">
   <Grid Margin="17,8,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Image Source="Assets/brand.png" Width="74" Height="74" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="3D Print Slicer Pro" FontSize="35" FontStyle="Italic" FontWeight="Bold"><TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White"/><GradientStop Color="#7DADCB" Offset="1"/></LinearGradientBrush></TextBlock.Foreground></TextBlock><TextBlock Text="Modelle intelligent teilen · Verbinder automatisch · Druckfertig" Foreground="#AFCCD9" FontSize="11" Margin="2,5,0,0"/></StackPanel>
    </Grid>
    <UniformGrid Grid.Column="1" Columns="7" Margin="8,3,0,3">
     <Button x:Name="ProjectNav" Style="{StaticResource GlowButton}" Click="ProjectClick" Padding="4"><StackPanel><TextBlock Text="⌂" FontSize="33" HorizontalAlignment="Center"/><TextBlock Text="Projekt" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button Click="LoadClick" Margin="3,0" Padding="4" Background="Transparent" BorderThickness="0"><StackPanel><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="29" HorizontalAlignment="Center" Margin="0,5"/><TextBlock Text="Modell laden" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="CutNav" Click="CutNavClick" Padding="4" Background="Transparent" BorderThickness="0"><StackPanel><TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="29" HorizontalAlignment="Center" Margin="0,5"/><TextBlock Text="Schneiden" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ConnectorNav" Click="ConnectorNavClick" Padding="4" Background="Transparent" BorderThickness="0"><StackPanel><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="29" HorizontalAlignment="Center" Margin="0,5"/><TextBlock Text="Verbinder" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="PreviewNav" Click="PreviewNavClick" Padding="4" Background="Transparent" BorderThickness="0"><StackPanel><TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="29" HorizontalAlignment="Center" Margin="0,5"/><TextBlock Text="Vorschau" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ExportNav" Click="ExportClick" Padding="4" Background="Transparent" BorderThickness="0"><StackPanel><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="29" HorizontalAlignment="Center" Margin="0,5"/><TextBlock Text="Export / Druck" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="SettingsNav" Click="SettingsClick" Padding="4" Background="Transparent" BorderThickness="0"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="29" HorizontalAlignment="Center" Margin="0,5"/><TextBlock Text="Einstellungen" HorizontalAlignment="Center"/></StackPanel></Button>
    </UniformGrid>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="10,12,10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="278"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="202"/><RowDefinition Height="10"/><RowDefinition Height="186"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Padding="10"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="▣  Projekt" Margin="0,0,0,8"/>
     <Button Content="📂   3D-Modell laden (STL / OBJ / 3MF)" Style="{StaticResource GlowButton}" Click="LoadClick" Padding="10,6" HorizontalContentAlignment="Left" FontSize="12" ToolTip="Ein geschlossenes 3D-Modell laden. STL und OBJ verwenden Millimeter."/>
     <Button Content="▣    Projekt speichern" Click="SaveClick" Padding="10,6" Margin="0,5,0,0" HorizontalContentAlignment="Left"/>
     <Button Content="▱    Projekt öffnen" Click="OpenProjectClick" Padding="10,6" Margin="0,5,0,0" HorizontalContentAlignment="Left"/>
     <Button Content="⊞    Neues Projekt" Click="NewClick" Padding="10,6" Margin="0,5,0,0" HorizontalContentAlignment="Left"/>
    </StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="10"><StackPanel><TextBlock Text="◇  Modell-Info" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⬡" FontSize="48" Foreground="#69DDF7" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><TextBlock x:Name="LengthText" Text="Länge:          —" Margin="0,2"/><TextBlock x:Name="WidthText" Text="Breite:          —" Margin="0,2"/><TextBlock x:Name="HeightText" Text="Höhe:           —" Margin="0,2"/></StackPanel></Grid>
     <Border BorderBrush="#314D60" BorderThickness="1" CornerRadius="5" Background="#13232F" Padding="7" Margin="0,8,0,6"><TextBlock x:Name="TotalText" Text="Kein Modell geladen" FontSize="11"/></Border>
     <TextBlock x:Name="MeshText" Text="STL, OBJ und 3MF · offline" Foreground="#9DB8C8" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Grid.Row="4" Style="{StaticResource Panel}" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="▤  Drucker / Optionen" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
     <ComboBox x:Name="PrinterBox" SelectionChanged="PrinterChanged" ToolTip="Gespeicherte lokale Druckerprofile"/>
     <TextBlock Text="Druckbett (Druckvolumen in mm)" Margin="0,8,0,5"/>
     <UniformGrid Columns="3"><StackPanel Margin="0,0,4,0"><TextBlock Text="X" Foreground="#9CBACA"/><TextBox x:Name="BedX" Text="220" ToolTip="Druckraum X in mm"/></StackPanel><StackPanel Margin="2,0,2,0"><TextBlock Text="Y" Foreground="#9CBACA"/><TextBox x:Name="BedY" Text="220" ToolTip="Druckraum Y in mm"/></StackPanel><StackPanel Margin="4,0,0,0"><TextBlock Text="Z" Foreground="#9CBACA"/><TextBox x:Name="BedZ" Text="250" ToolTip="Druckraum Z in mm"/></StackPanel></UniformGrid>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="83"/></Grid.ColumnDefinitions><TextBlock Text="Sicherheitsabstand:" VerticalAlignment="Center"/><TextBox x:Name="MarginBox" Grid.Column="1" Text="0,2" ToolTip="Abstand je Seite in mm"/></Grid>
     <Button Content="+ Druckerprofil speichern" Click="SavePrinterClick" Padding="6" Margin="0,6,0,0" FontSize="11"/>
    </StackPanel></ScrollViewer></Border>
   </Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="205"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Padding="0" BorderBrush="#32AFD3"><Grid>
     <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#07121B"/><GradientStop Color="#102435" Offset="1"/></LinearGradientBrush></Grid.Background>
     <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="55"/></Grid.RowDefinitions>
     <Grid Margin="18,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border HorizontalAlignment="Left" BorderBrush="#50B5D5" BorderThickness="1" CornerRadius="8" Padding="12,6" Background="#122533"><TextBlock Text="Original-Modell" FontSize="16" FontWeight="SemiBold"/></Border><Border Grid.Column="1" HorizontalAlignment="Center" BorderBrush="#50B5D5" BorderThickness="1" CornerRadius="8" Padding="12,6" Background="#122533"><TextBlock x:Name="ResultTitle" Text="Automatisch geteilt (Druckteile)" FontSize="15" FontWeight="SemiBold"/></Border></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><local:ModelViewport x:Name="OriginalView"/><TextBlock Grid.Column="1" Text="»" FontSize="70" Foreground="#2AD7FF" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Effect><DropShadowEffect Color="#00C8FF" BlurRadius="18" ShadowDepth="0"/></TextBlock.Effect></TextBlock><local:ModelViewport x:Name="PartsView" Grid.Column="2"/>
      <TextBlock x:Name="EmptyLabel" Text="3D-Modell laden oder Demo öffnen" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#8DB3C7" IsHitTestVisible="False"/>
     </Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button Content="↻" FontSize="22" Padding="9,2" Click="ResetViewClick" ToolTip="Beide Kameras zurücksetzen · Doppelklick im Modell"/>
      <Button Content="⊞" FontSize="22" Padding="9,2" Margin="5,0" Click="GridClick" ToolTip="Bodengitter ein-/ausblenden"/>
      <Button Content="↗" FontSize="22" Padding="9,2" Click="ExplodeClick" ToolTip="Explosionsansicht ein-/ausschalten"/>
      <Button Content="◈" FontSize="22" Padding="9,2" Margin="5,0" Click="FocusPartClick" ToolTip="Ausgewähltes Teil einzeln anzeigen / alle Teile"/>
      <ComboBox x:Name="ViewMode" Width="153" SelectionChanged="ViewModeChanged" ToolTip="Ansichtsmodus"><ComboBoxItem Content="Aufgeteiltes Modell"/><ComboBoxItem Content="Schnittvorschau"/><ComboBoxItem Content="Explosionsansicht"/><ComboBoxItem Content="Montageansicht"/><ComboBoxItem Content="Einzelteilansicht"/><ComboBoxItem Content="Originalmodell"/></ComboBox>
      <Button Content="…" FontSize="20" Padding="9,2" Margin="5,0,0,0" Click="ViewOptionsClick" ToolTip="Transparenz, Schnittlinien, Verbinder und Montage"/>
     </StackPanel>
    </Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35*"/><ColumnDefinition Width="65*"/></Grid.ColumnDefinitions>
     <Border BorderBrush="#2B5972" BorderThickness="0,0,1,0" Padding="14,10"><StackPanel><TextBlock Text="▣  Ergebnis" Style="{StaticResource Heading}" Margin="0,0,0,8"/><TextBlock x:Name="ResultStatus" Text="Bereit zum Laden" Foreground="#65E5CC" TextWrapping="Wrap" FontSize="13"/><TextBlock x:Name="ResultSummary" Text="Alle Geometriedaten werden lokal verarbeitet." Margin="0,7,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="22"/>
      <Button Content="Prüfbericht / Montageplan" Click="ReportClick" FontSize="11" Padding="6,4" Margin="0,9,0,0" HorizontalAlignment="Left"/>
     </StackPanel></Border>
     <Grid Grid.Column="1" Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition/><RowDefinition Height="21"/></Grid.RowDefinitions><TextBlock x:Name="PartsHeading" Text="Teile-Vorschau (0 Teile)" FontSize="16" FontWeight="SemiBold"/>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Thumbnails" Orientation="Horizontal"/></ScrollViewer>
      <TextBlock x:Name="SelectionLabel" Grid.Row="2" Text="Teil anklicken, um es auszuwählen" Foreground="#8CAEBF" FontSize="11" VerticalAlignment="Bottom"/>
     </Grid>
    </Grid></Border>
   </Grid>
   <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="224"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="112"/></Grid.RowDefinitions>
    <Border x:Name="CutPanel" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="♧  Schnitt-Einstellungen" Style="{StaticResource Heading}"/>
     <ComboBox x:Name="StrategyBox" SelectedIndex="0" SelectionChanged="StrategyChanged"><ComboBoxItem Content="Adaptiv · Modellform berücksichtigen" Tag="adaptive"/><ComboBoxItem Content="Möglichst gleich große Teile" Tag="equal"/><ComboBoxItem Content="Möglichst wenige Rasterzellen" Tag="few"/><ComboBoxItem Content="Benutzerdefiniertes Zielmaß" Tag="custom"/><ComboBoxItem Content="Nach Farbe trennen" Tag="color" ToolTip="Geschlossene Farbgruppen einer 3MF als getrennte Druckteile ausgeben."/></ComboBox>
     <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Text="Teilgröße (Zielmaß)" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="TargetBox" Text="220" ToolTip="Maximales Teilmaß in mm, bei benutzerdefinierter Aufteilung"/></Grid>
     <CheckBox x:Name="OptimizeBox" Content="Druckraumausrichtung optimieren" IsChecked="True" ToolTip="Alle sechs Achsenanordnungen prüfen. Keine freie Winkeloptimierung." Margin="0,10,0,4"/>
     <CheckBox x:Name="PathCheckBox" Content="Montagewege prüfen" IsChecked="True" FontSize="12" Margin="0,2,0,3" ToolTip="Gerade Montagewege werden durchgehend geprüft. Bei Außenschrauben wird der Gewindeeingriff an einzelnen Positionen geprüft."/>
     <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Button Content="Manuelle Schnitte / Skalieren" Click="AdvancedClick" Padding="8,5" FontSize="11"/><Button Content="⤾" Click="OrientClick" Margin="5,0,0,0" Padding="6,3" FontSize="18" ToolTip="Modell frei ausrichten · X/Y/Z-Drehwinkel"/><Button x:Name="UndoButton" Content="↶" Click="UndoClick" Margin="7,0,4,0" Padding="8,3" ToolTip="Schnitt rückgängig (Strg+Z)"/><Button x:Name="RedoButton" Content="↷" Click="RedoClick" Padding="8,3" ToolTip="Schnitt wiederholen (Strg+Y)"/></StackPanel>
    </StackPanel></Border>
    <Border Grid.Row="2" x:Name="ConnectorPanel" Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="♧  Verbinder (automatisch)" Style="{StaticResource Heading}"/>
     <ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="KindChanged"><ComboBoxItem Content="Dübel (rund)" Tag="round"/><ComboBoxItem Content="Steckverbinder (rechteckig)" Tag="rect"/><ComboBoxItem Content="Nut und Feder (gerade)" Tag="tongue"/><ComboBoxItem Content="Schwalbenschwanz (seitlich)" Tag="dovetail"/><ComboBoxItem Content="Steckclip (Rastarme)" Tag="clip"/><ComboBoxItem Content="Außenschraube mit Gewinde" Tag="screw"/></ComboBox>
     <UniformGrid Columns="6" Margin="0,9,0,10"><Button x:Name="RoundChoice" Click="RoundClick" Style="{StaticResource GlowButton}" Padding="3,5" Margin="0,0,3,0"><StackPanel><TextBlock Text="▰" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="Dübel" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="RectChoice" Click="RectClick" Padding="3,5" Margin="0,0,3,0"><StackPanel><TextBlock Text="▤" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="Zapfen" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="TongueChoice" Click="TongueClick" Padding="2,5" Margin="0,0,3,0" ToolTip="Gerade Feder mit geschlossener Nut; integriert oder separat"><StackPanel><TextBlock Text="◩" FontSize="30"/><TextBlock Text="Nut/Feder" FontSize="9"/></StackPanel></Button><Button x:Name="DovetailChoice" Click="DovetailClick" Padding="2,5" Margin="0,0,3,0" ToolTip="Schwalbenschwanz mit seitlich offener Nut"><StackPanel><TextBlock Text="◢" FontSize="30"/><TextBlock Text="Schwalbe" FontSize="9"/></StackPanel></Button><Button x:Name="ClipChoice" Click="ClipClick" Padding="2,5" Margin="0,0,3,0" ToolTip="Steckclip mit elastischen Rastarmen"><StackPanel><TextBlock Text="↪" FontSize="30"/><TextBlock Text="Clip" FontSize="9"/></StackPanel></Button><Button x:Name="ScrewChoice" Click="ScrewClick" Padding="2,5" ToolTip="Außenschraube mit gedrucktem Gewinde"><StackPanel><TextBlock Text="♙" FontSize="30"/><TextBlock Text="Gewinde" FontSize="9"/></StackPanel></Button></UniformGrid>
     <CheckBox x:Name="AutoSizeBox" Content="Verbindermaß automatisch verkleinern" FontSize="12" ToolTip="Die gewählten Maße sind Obergrenzen. Mindestmaße unter Einstellungen; die Wandreserve wird nicht reduziert. Die Federlänge bleibt unverändert."/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <TextBlock x:Name="WidthLabel" Text="Durchmesser / Breite:" VerticalAlignment="Center"/><TextBox x:Name="DiameterBox" Grid.Column="1" Text="10" Margin="0,2" ToolTip="Durchmesser oder Breite in mm"/>
      <TextBlock x:Name="DepthLabel" Grid.Row="1" Text="Einstecktiefe je Seite:" VerticalAlignment="Center"/><TextBox x:Name="DepthBox" Grid.Row="1" Grid.Column="1" Text="15" Margin="0,2"/>
      <TextBlock Grid.Row="2" Text="Anzahl pro Schnittfläche:" VerticalAlignment="Center"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="CountBox" SelectedIndex="1" Margin="0,2"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/></ComboBox>
      <TextBlock Grid.Row="3" Text="Spiel / Gesamtzugabe:" VerticalAlignment="Center"/><TextBox x:Name="ToleranceBox" Grid.Row="3" Grid.Column="1" Text="0,2" Margin="0,2" ToolTip="Lochdurchmesser minus Dübelmaß; bei Nut/Feder Gesamtzugabe in Breite und Länge. Je Seite die Hälfte."/>
     </Grid>
     <Grid x:Name="TongueFields" Visibility="Collapsed" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock x:Name="RailLengthLabel" Text="Federlänge in der Fläche:" VerticalAlignment="Center"/><TextBox x:Name="TongueLengthBox" Grid.Column="1" Text="40" ToolTip="mm, mindestens die Federbreite. Beide Flächenrichtungen werden geprüft. Die Größenautomatik ändert diese Länge nicht."/></Grid>
     <Grid x:Name="RectFields" Visibility="Collapsed" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="Zapfenhöhe in der Fläche:" VerticalAlignment="Center"/><TextBox x:Name="RectHeightBox" Grid.Column="1" Text="0" ToolTip="Höhe in mm. 0 übernimmt die Breite. Bei Größenautomatik skalieren Höhe und Breite proportional."/></Grid>
     <StackPanel x:Name="ClipFields" Visibility="Collapsed" Margin="0,5,0,0">
      <TextBlock Text="Grenze berechnete Armdehnung (%)" TextWrapping="Wrap"/>
      <TextBox x:Name="ClipStrainBox" Text="3" ToolTip="Geometrischer Filter. Zulässigen Wert mit dem gewählten Material und der Druckrichtung per Passprobe bestimmen."/>
     </StackPanel>
     <Grid x:Name="ThreadFields" Visibility="Collapsed" Margin="0,5,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <TextBlock Text="Gewindelänge (mm)" VerticalAlignment="Center"/><TextBox x:Name="ThreadLengthBox" Grid.Column="1" Text="12" Margin="0,2"/>
      <TextBlock Grid.Row="1" Text="Steigung (mm)" VerticalAlignment="Center"/><TextBox x:Name="ThreadPitchBox" Grid.Row="1" Grid.Column="1" Text="2" Margin="0,2"/>
     </Grid>
     <ComboBox x:Name="ModeBox" SelectedIndex="1" Margin="0,8,0,0"><ComboBoxItem x:Name="IntegratedMode" Content="A · In die Teile integriert" Tag="integrated"/><ComboBoxItem Content="B · Verbinder separat drucken" Tag="separate"/><ComboBoxItem x:Name="MixedMode" Content="C · Integriert und separat" Tag="mixed"/><ComboBoxItem Content="Ohne Verbinder schneiden" Tag="none"/></ComboBox>
     <CheckBox x:Name="AcrossColorsBox" Content="Verbinder zwischen Farbgruppen" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="Bei der Farbtrennung auch gemeinsame ebene Kontaktflächen verbinden. Typ, Maße und Wandreserve gelten wie bei normalen Schnitten."/>
     <Button Content="Verbinderpositionen bearbeiten …" Click="ConnectorPositionsClick" Margin="0,8,0,0"/>
     <TextBlock Text="Wandreserve und Material unter Einstellungen." FontSize="10" Foreground="#91B2C4" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer></Border>
    <Button x:Name="SliceButton" Grid.Row="4" Click="SliceClick" Style="{StaticResource GlowButton}" Padding="8" BorderThickness="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="▷" FontSize="67" Foreground="#72F1FF" VerticalAlignment="Center"/><TextBlock x:Name="SliceLabel" Grid.Column="1" Text="Modell schneiden&#x0a;&amp; Verbinder setzen&#x0a;(Automatisch)" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#14526B" BorderThickness="0,1,0,0" Background="#08121B"><Grid Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="75"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Bereit · Vollständig offline" FontSize="11" Foreground="#A8CADB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Grid.Column="1" Height="5" Maximum="100" Foreground="#10CDFA" Background="#142C3D" BorderThickness="0"/><Button x:Name="CancelButton" Grid.Column="2" Content="Abbrechen" Click="CancelClick" FontSize="10" Padding="4,0" Margin="8,2" Visibility="Collapsed"/><TextBlock Grid.Column="3" x:Name="VersionText" Foreground="#4CC8D9" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border>
 </Grid>
</Window>
